# ---- shared by api + worker ----
DATABASE_URL=postgres://pullpanda:pullpanda@localhost:5432/pullpanda
REDIS_URL=redis://localhost:6379

# ---- GitHub App (Settings → Developer settings → GitHub Apps) ----
# Permissions: Pull requests (read & write), Contents (read), Metadata (read).
# Events: Pull request, Installation, Installation repositories.
# Webhook URL: <API_URL>/webhooks/github   Callback URL: <API_URL>/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=          # PEM with \n escapes, or base64 of the .pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- api ----
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
SESSION_SECRET=change-me-to-32-or-more-random-characters
COOKIE_SAMESITE=lax              # "none" when web and api are on different sites

# ---- Polar (per-repository Pro subscription) ----
# Webhook URL: <API_URL>/webhooks/polar  (subscription.* events)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
POLAR_ENVIRONMENT=sandbox

# ---- worker: the review model ----
LLM_PROVIDER=anthropic           # anthropic (default) or openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low             # low | medium | high | xhigh | max
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# LLM_INPUT_USD_PER_MTOK=        # override list prices used for cost per review
# LLM_OUTPUT_USD_PER_MTOK=
WORKER_CONCURRENCY=4
WORKER_RATE_PER_MIN=30           # reviews started per minute, all replicas: match your OpenAI limit

# ---- web (build time) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GITHUB_APP_SLUG=
