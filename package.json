{
  "name": "pullpanda",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "bench"],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:api": "bun run --filter @pullpanda/api dev",
    "dev:worker": "bun run --filter @pullpanda/worker dev",
    "dev:web": "bun run --filter @pullpanda/web dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "bun run --filter @pullpanda/db generate",
    "db:migrate": "bun run --filter @pullpanda/db migrate",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
